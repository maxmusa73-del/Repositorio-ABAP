@EndUserText.label: 'SSS'
@MappingRole: true
define role ZMMS_R_EMPLOYEE {
    grant 
        select
            on
                ZMMS_R_EMPLOYEE
                    where
                        ( DepartmentId ) = aspect pfcg_auth(/LRN/DPMNT, /LRN/DPMNT, ACTVT = '03');
                        
}
