@EndUserText.label: 'Departamento Control de Acceso'
@MappingRole: true
define role ZMMS_R_DEPARTMENT {
    grant 
        select
            on
                ZMMS_R_DEPARTMENT
                    where
                        (Id) = aspect pfcg_auth(/LRN/DPMNT, /LRN/DPMNT, ACTVT = '03');
                        
}